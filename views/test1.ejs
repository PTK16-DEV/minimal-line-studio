    <!-- Hélice : disque en mouvement -->
    <g transform="translate(752 90)">
      <ellipse rx="3.5" ry="27" stroke-width="0.8" opacity=".55" stroke-dasharray="5 6">
        <animate attributeName="stroke-dashoffset" values="0;-11" dur="0.25s" repeatCount="indefinite"/>
      </ellipse>
      <g stroke-width="1.4">
        <animateTransform attributeName="transform" type="scale" values="1 1;1 0.08;1 1" keyTimes="0;.5;1" calcMode="spline" keySplines=".4 0 .6 1;.4 0 .6 1" dur="0.2s" repeatCount="indefinite"/>
