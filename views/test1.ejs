<script>
var TAU = Math.PI * 2;
var PLANE_C = { x: 630, y: 90 };
var HOOK = { x: 482.7, y: 89.3 };
function f1(v) { return (Math.round(v * 10) / 10).toString(); }
function f2(v) { return (Math.round(v * 100) / 100).toString(); }
function planeState(phi) { return { dy: -4 * Math.sin(phi), a: -1.5 * Math.cos(phi) }; }
function toWorld(p, st) {
  var r = st.a * Math.PI / 180, c = Math.cos(r), s = Math.sin(r);
  var dx = p.x - PLANE_C.x, dy = p.y - PLANE_C.y;
  return { x: PLANE_C.x + dx * c - dy * s, y: PLANE_C.y + dx * s + dy * c + st.dy };
}
function poly(arr, a, b) {
  var s = '';
  for (var i = a; i <= b; i++) s += (i === a ? 'M' : ' L') + f1(arr[i].x) + ' ' + f1(arr[i].y);
  return s;
}
function banniereFrame(theta, texte) {
  var L = 400, N = 40, H0 = 34, i;
  var hook = toWorld(HOOK, planeState(theta));
  var xf = hook.x - 56, pts = [], tan = [], top = [], bot = [], inT = [], inB = [];
  for (i = 0; i <= N; i++) {
    var u = i / N, phi = theta - 1.1 * u;
    var yb = toWorld(HOOK, planeState(phi)).y + 4 * Math.min(1, u * 5);
    var amp = 1.2 + 10 * u;
    var w = amp * Math.sin(TAU * 1.35 * u - theta) + 0.35 * amp * Math.sin(TAU * 2.7 * u - 2 * theta);
    pts.push({ x: xf - L * u, y: yb + w });
  }
  for (i = 0; i <= N; i++) {
    var a = pts[Math.max(0, i - 1)], b = pts[Math.min(N, i + 1)];
    var tx = b.x - a.x, ty = b.y - a.y, m = Math.hypot(tx, ty);
    tan.push({ x: tx / m, y: ty / m });
  }
  for (i = 0; i <= N; i++) {
    var u2 = i / N;
    var h = (H0 - 5 * u2) * (1 + 0.12 * Math.cos(TAU * 1.35 * u2 - theta + 1.2));
    var nx = -tan[i].y, ny = tan[i].x;
    top.push({ x: pts[i].x + nx * h / 2, y: pts[i].y + ny * h / 2 });
    bot.push({ x: pts[i].x - nx * h / 2, y: pts[i].y - ny * h / 2 });
    inT.push({ x: pts[i].x + nx * (h / 2 - 3.4), y: pts[i].y + ny * (h / 2 - 3.4) });
    inB.push({ x: pts[i].x - nx * (h / 2 - 3.4), y: pts[i].y - ny * (h / 2 - 3.4) });
  }
  var notch = pts[38];
  var botRev = bot.slice().reverse();
  var outline = poly(top, 0, N) + ' L' + f1(notch.x) + ' ' + f1(notch.y) + ' ' + poly(botRev, 0, N).replace('M', 'L') + ' Z';
  var B = { x: pts[0].x + 16, y: pts[0].y };
  var cable = 'M' + f1(hook.x) + ' ' + f1(hook.y) + ' Q' + f1((hook.x + B.x) / 2) + ' ' + f1(Math.max(hook.y, B.y) + 4) + ' ' + f1(B.x) + ' ' + f1(B.y) +
    ' M' + f1(B.x) + ' ' + f1(B.y) + ' L' + f1(top[0].x) + ' ' + f1(top[0].y) +
    ' M' + f1(B.x) + ' ' + f1(B.y) + ' L' + f1(bot[0].x) + ' ' + f1(bot[0].y);
  var chars = Array.from(texte), n = chars.length, fs = 16, step = fs * 2.25, avail = L * 0.8;
  if (n > 1 && (n - 1) * step > avail) { step = avail / (n - 1); fs = Math.max(7, step / 2.25); }
  var span = (n - 1) * step, letters = [];
  chars.forEach(function (ch, k) {
    var uu = 0.5 + span / (2 * L) - k * step / L;
    var idx = Math.min(N - 1e-6, Math.max(0, uu * N)), i0 = Math.floor(idx), fr = idx - i0;
    var p0 = pts[i0], p1 = pts[i0 + 1], t0 = tan[i0], t1 = tan[i0 + 1];
    var x = p0.x + (p1.x - p0.x) * fr, y = p0.y + (p1.y - p0.y) * fr;
    var tx2 = t0.x + (t1.x - t0.x) * fr, ty2 = t0.y + (t1.y - t0.y) * fr;
    letters.push({ ch: ch, x: f1(x), y: f1(y), rot: f2(Math.atan2(-ty2, -tx2) * 180 / Math.PI) });
  });
  return { outline: outline, innerT: poly(inT, 1, 35), innerB: poly(inB, 1, 35), cable: cable, letters: letters, fs: Math.round(fs * 10) / 10 };
}
function scarfFrame(theta) {
  var N = 14, ax = 627, ay = 69.5, top = [], bot = [];
  for (var i = 0; i <= N; i++) {
    var s = i / N, amp = 0.6 + 5.5 * s;
    var x = ax - 58 * s, y = ay + 1.5 * s + amp * Math.sin(TAU * 1.6 * s - 2 * theta);
    var w = 3.8 * (1 - 0.5 * s);
    top.push({ x: x, y: y - w / 2 }); bot.push({ x: x, y: y + w / 2 });
  }
  return poly(top, 0, N) + ' ' + poly(bot.slice().reverse(), 0, N).replace('M', 'L') + ' Z';
}

(function () {
  document.querySelector('.vol').style.animationDuration = DUREE_TRAVERSEE + 's';
  var svg = document.getElementById('scene'), NS = 'http://www.w3.org/2000/svg';
  var banPath = document.getElementById('banPath'), banInT = document.getElementById('banInT'),
      banInB = document.getElementById('banInB'), banCable = document.getElementById('banCable'),
      gLet = document.getElementById('banLetters');
  // Les animations SMIL de l'avion et ce script partagent la même horloge : boucle de 3 s parfaite.
  banPath.innerHTML = ''; banInT.innerHTML = ''; banInB.innerHTML = ''; banCable.innerHTML = '';
  var f0 = banniereFrame(0, TEXTE_BANNIERE);
  var nodes = Array.from(TEXTE_BANNIERE).map(function (c) {
    var t = document.createElementNS(NS, 'text');
    t.setAttribute('text-anchor', 'middle'); t.setAttribute('dy', '.35em'); t.setAttribute('font-size', f0.fs);
    t.textContent = c; gLet.appendChild(t); return t;
  });
  function maj() {
    var th = TAU * ((svg.getCurrentTime() % 3) / 3), fr = banniereFrame(th, TEXTE_BANNIERE);
    banPath.setAttribute('d', fr.outline); banInT.setAttribute('d', fr.innerT);
    banInB.setAttribute('d', fr.innerB); banCable.setAttribute('d', fr.cable);
    fr.letters.forEach(function (l, i) { nodes[i].setAttribute('transform', 'translate(' + l.x + ' ' + l.y + ') rotate(' + l.rot + ')'); });
    requestAnimationFrame(maj);
  }
  maj();
})();
</script>
