      <circle cx="556" cy="79.5" r=".5"/><circle cx="564" cy="79.5" r=".5"/><circle cx="556" cy="84" r=".5"/><circle cx="564" cy="84" r=".5"/><circle cx="556" cy="88.5" r=".5"/><circle cx="564" cy="88.5" r=".5"/><circle cx="556" cy="93" r=".5"/><circle cx="564" cy="93" r=".5"/><circle cx="556" cy="97.5" r=".5"/><circle cx="564" cy="97.5" r=".5"/><circle cx="738" cy="80" r=".5"/><circle cx="738" cy="85" r=".5"/><circle cx="738" cy="90" r=".5"/><circle cx="738" cy="95" r=".5"/><circle cx="738" cy="100" r=".5"/>
